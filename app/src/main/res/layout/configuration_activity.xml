<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">
    
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/widget_configuration"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:layout_marginBottom="16dp" />
            
        <!-- Widget Preview Section -->
        <androidx.cardview.widget.CardView
            android:id="@+id/preview_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/preview"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="16sp"
                    android:layout_marginBottom="8dp" />
                
                <FrameLayout
                    android:id="@+id/preview_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">
                    
                    <include
                        android:id="@+id/widget_preview_layout"
                        layout="@layout/widget_preview" />
                </FrameLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Background Settings Section -->
        <androidx.cardview.widget.CardView
            android:id="@+id/background_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/background_color"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="16sp"
                    android:layout_marginBottom="8dp" />

                <RadioGroup
                    android:id="@+id/background_color_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/bg_color_transparent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="?android:attr/textColorPrimary"
                        android:padding="8dp"
                        android:text="@string/transparent" />

                    <RadioButton
                        android:id="@+id/bg_color_dark"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="?android:attr/textColorPrimary"
                        android:padding="8dp"
                        android:text="@string/dark" />

                    <RadioButton
                        android:id="@+id/bg_color_light"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="?android:attr/textColorPrimary"
                        android:padding="8dp"
                        android:text="@string/light" />
                        
                    <RadioButton
                        android:id="@+id/bg_color_custom"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="?android:attr/textColorPrimary"
                        android:padding="8dp"
                        android:text="@string/custom_colors" />
                </RadioGroup>
                
                <!-- Transparency controls for all background types -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/transparency"
                    android:textColor="?android:attr/textColorPrimary"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="4dp" />
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0%"
                        android:textColor="?android:attr/textColorSecondary" />
                        
                    <SeekBar
                        android:id="@+id/bg_transparency_slider"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="255"
                        android:progress="128"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp" />
                        
                    <TextView
                        android:id="@+id/transparency_percentage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="50%"
                        android:textColor="?android:attr/textColorSecondary" />
                </LinearLayout>
                
                <!-- Custom color options -->
                <LinearLayout
                    android:id="@+id/bg_color_custom_options"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:layout_marginTop="16dp">
                    
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/select_custom_color"
                        android:textColor="?android:attr/textColorPrimary"
                        android:layout_marginBottom="8dp" />
                        
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        
                        <View
                            android:id="@+id/bg_color_preview"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="#FF5722"
                            android:layout_marginEnd="16dp" />
                            
                        <Button
                            android:id="@+id/bg_color_picker_button"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/choose_color"
                            android:stateListAnimator="@android:animator/fade_in" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Text Color Section -->
        <androidx.cardview.widget.CardView
            android:id="@+id/text_color_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/text_color"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="16sp"
                    android:layout_marginBottom="8dp" />

                <RadioGroup
                    android:id="@+id/text_color_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/text_color_light"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="?android:attr/textColorPrimary"
                        android:padding="8dp"
                        android:text="@string/light" />

                    <RadioButton
                        android:id="@+id/text_color_dark"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="?android:attr/textColorPrimary"
                        android:padding="8dp"
                        android:text="@string/dark" />
                        
                    <RadioButton
                        android:id="@+id/text_color_custom"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="?android:attr/textColorPrimary"
                        android:padding="8dp"
                        android:text="@string/custom_colors" />
                </RadioGroup>
                
                <!-- Text Custom color options -->
                <LinearLayout
                    android:id="@+id/text_color_custom_options"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:layout_marginTop="16dp">
                    
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/select_custom_color"
                        android:textColor="?android:attr/textColorPrimary"
                        android:layout_marginBottom="8dp" />
                        
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        
                        <View
                            android:id="@+id/text_color_preview"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="#FFFFFF"
                            android:layout_marginEnd="16dp" />
                            
                        <Button
                            android:id="@+id/text_color_picker_button"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/choose_color"
                            android:stateListAnimator="@android:animator/fade_in" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="16dp">
            
            <Button
                android:id="@+id/reset_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/reset_to_defaults"
                style="?android:attr/buttonBarButtonStyle"
                android:stateListAnimator="@android:animator/fade_in"
                android:layout_marginEnd="8dp" />
                
            <Button
                android:id="@+id/save_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/save"
                android:stateListAnimator="@android:animator/fade_in" />
        </LinearLayout>
    </LinearLayout>
</ScrollView> 
