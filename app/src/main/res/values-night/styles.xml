<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Define animation styles for the widget configuration activity in dark mode -->
    <style name="WidgetConfigTheme" parent="android:Theme.DeviceDefault.NoActionBar">
        <!-- Status bar and navigation bar settings for dark mode -->
        <item name="android:statusBarColor">?android:attr/colorBackground</item>
        <item name="android:navigationBarColor">?android:attr/colorBackground</item>
        
        <!-- Animation settings -->
        <item name="android:windowActivityTransitions">true</item>
        <item name="android:windowEnterTransition">@android:transition/fade</item>
        <item name="android:windowExitTransition">@android:transition/fade</item>
        
        <!-- Card styles -->
        <item name="android:colorAccent">@color/widget_background_light_color</item>
        
        <!-- Prevent harsh window background color -->
        <item name="android:windowBackground">?android:attr/colorBackground</item>
    </style>
</resources> 
